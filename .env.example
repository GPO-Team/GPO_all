# Frontend runtime endpoints (used by Vite)
# PostgreSQL (compose.postgres.yaml). Set a private password before db:up.
POSTGRES_DB=gpo
POSTGRES_USER=gpo
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

VITE_BRIDGE_HOST=127.0.0.1
VITE_TELEMETRY_PORT=9001
VITE_ROUTE_PORT=9002
VITE_SOLVER_PORT=9003

# Bridge listeners (used by ws-bridge.cjs and telemetry-server.cjs)
# Use BRIDGE_BIND_HOST=0.0.0.0 inside Docker.
BRIDGE_BIND_HOST=127.0.0.1
TELEMETRY_PORT=9001
ROUTE_PORT=9002
SOLVER_PORT=9003
WEB_STATE_DIR=./web_state
# Windows: ./native/build/gpo_route_solver.exe
# Linux/Docker: ./native/build/gpo_route_solver
SOLVER_PATH=./native/build/gpo_route_solver.exe
MOCK_TELEMETRY=0

# Independent Webots gateway (only this service reads/writes WEB_STATE_DIR)
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_PORT=9004
GATEWAY_URL=http://127.0.0.1:9004
# Required when gateway listens outside loopback; share with its service clients.
GATEWAY_TOKEN=
# Alternative: UTF-8 secret file, relative to project root. Do not set both.
# GATEWAY_TOKEN_FILE=./secrets/gateway-token
# Private mission database, not shared with the gateway or Webots.
MISSION_STATE_DIR=./data/missions
# Optional rotating application logs: 5 MiB x 4 files per service; stdout always enabled.
# LOG_DIR=./logs
# Optional per-service listen addresses:
# ROUTE_BIND_HOST=127.0.0.1
# TELEMETRY_BIND_HOST=127.0.0.1
# SOLVER_BIND_HOST=127.0.0.1
# Optional independent frontend endpoints (override host/port defaults):
# VITE_PLANNING_URL=http://127.0.0.1:9003
# VITE_MISSION_URL=http://127.0.0.1:9002
# VITE_ROUTE_URL=ws://127.0.0.1:9002/ui
# VITE_TELEMETRY_URL=ws://127.0.0.1:9001
