{
  "name": "bnts-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare:viewer": "node scripts/prepare-webots-viewer.mjs",
    "dev": "vite --host 127.0.0.1",
    "bridge": "node ws-bridge.cjs",
    "service:planning": "node bridge/processes/run-planning-service.cjs",
    "service:route": "node bridge/processes/run-route-service.cjs",
    "service:telemetry": "node bridge/processes/run-telemetry-service.cjs",
    "telemetry:mock": "node telemetry-server.cjs",
    "native:build": "native\\build_msvc.bat",
    "native:test": "native\\run_tests_msvc.bat",
    "native:build:linux": "cmake -S native -B native/build -DCMAKE_BUILD_TYPE=Release && cmake --build native/build --config Release --parallel",
    "webots:build": "webots\\controllers\\youbot_web\\build_youbot_web.bat",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:bridge": "node scripts/bridge-smoke-test.mjs",
    "test:webots": "webots\\controllers\\youbot_web\\run_controller_tests.bat",
    "preview": "vite preview",
    "test:services": "node scripts/services-smoke-test.mjs",
    "service:gateway": "node bridge/processes/run-gateway-service.cjs",
    "test:simulation": "node scripts/simulation-smoke-test.mjs",
    "test:manipulator": "node scripts/manipulator-contact-smoke-test.mjs",
    "test:delivery": "node scripts/manipulator-smoke-test.mjs --mobile --near-object --inject-route",
    "test:delivery:after-demo": "node scripts/manipulator-smoke-test.mjs --after-demo",
    "test:route-after-delivery": "node scripts/manipulator-smoke-test.mjs --route-after-delivery",
    "start": "node scripts/start-stack.mjs",
    "test:docker": "node scripts/docker-smoke-test.mjs",
    "start:container": "node scripts/start-container-stack.mjs",
    "test:container": "node scripts/full-container-smoke-test.mjs",
    "test:manipulator:contacts": "node scripts/manipulator-contact-smoke-test.mjs",
    "test:manipulator:def": "node scripts/manipulator-smoke-test.mjs"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.15.1",
    "ws": "^8.18.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vite": "^7.2.4",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
